# GEMINI_API_KEY: Required for server-side AI Situation Report Copilot synthesis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional LLM fallback key for standalone Python FastAPI deployment
OPENAI_API_KEY=""

# Copernicus Data Space Ecosystem (CDSE) OAuth2 credentials for live Sentinel-1 / Sentinel-2 / DEM ingestion
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

